# Copy to .env and adjust. Every value here is optional — the server boots with
# sensible defaults and prints a generated admin password on first run.

# --- server ---
PORT=4000
HOST=0.0.0.0
DB_PATH=./data/engage.db

# --- dashboard access ---
# Pin the dashboard password. Leave empty to keep the generated one.
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
# Set to true once the dashboard is served over HTTPS.
SECURE_COOKIES=false

# --- visitor registration ---
# Verify that the email domain really accepts mail (MX/A lookup).
EMAIL_DNS_CHECK=true
EMAIL_DNS_TIMEOUT_MS=3000
BLOCK_DISPOSABLE_EMAIL=true

# --- behind a reverse proxy (nginx, Caddy, Cloudflare) ---
# Only enable when a proxy you control sets X-Forwarded-For.
TRUST_PROXY=false

# --- limits ---
MAX_COMMENT_LENGTH=2000
COMMENT_COOLDOWN_MS=20000
COMMENTS_PER_HOUR=12
RATE_READ=240
RATE_WRITE=20
RATE_REGISTER=10
RATE_LOGIN=10
