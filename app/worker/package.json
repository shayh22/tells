{
  "name": "tells-engage-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers + D1 deployment of the comments and likes server",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create tells-engage",
    "db:init": "wrangler d1 execute tells-engage --file schema.sql --remote",
    "db:init:local": "wrangler d1 execute tells-engage --file schema.sql --local",
    "password": "wrangler secret put ADMIN_PASSWORD",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
